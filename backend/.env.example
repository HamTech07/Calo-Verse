# Copy to .env and enter your key locally. Backend use only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FIREBASE_PROJECT_ID=caloverse
# One-line JSON from Firebase Console > Project settings > Service accounts.
# Required only for secure promo redemption and admin subscription reports.
FIREBASE_SERVICE_ACCOUNT_JSON=
PROMO_CODE=1519
PROMO_ENABLED=true
ADMIN_EMAILS=
PORT=3001
