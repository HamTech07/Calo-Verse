{
  "expo": {
    "name": "Calo Verse",
    "slug": "calo-verse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "caloverse",
    "icon": "./assets/caloverse-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Calo Verse to photograph your food.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Calo Verse to choose a food photo.",
          "microphonePermission": "Allow Calo Verse to record your spoken meal when you tap Record."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Calo Verse to record your spoken meal when you tap Record.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-web-browser"
    ],
    "splash": {
      "image": "./assets/caloverse-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#202625"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caloverse.app"
    },
    "android": {
      "package": "com.caloverse.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E2322",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.727919495971-pt308h42n8n9kiamhf93l3ahrgbpnaps"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/caloverse-icon.png",
      "name": "Calo Verse"
    },
    "extra": {
      "eas": {
        "projectId": "35b5e909-fd07-4948-acd7-f49c17687e2c"
      }
    }
  }
}
