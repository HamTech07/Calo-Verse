{
  "expo": {
    "name": "Calo Verse",
    "slug": "calo-verse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "caloverse",
    "icon": "./assets/caloverse-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Calo Verse to photograph your food.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Calo Verse to choose a food photo.",
          "microphonePermission": "Allow Calo Verse to record your spoken meal when you tap Record."
        }
      ],
      ["expo-audio", { "microphonePermission": "Allow Calo Verse to record your spoken meal when you tap Record.", "recordAudioAndroid": true, "enableBackgroundRecording": false, "enableBackgroundPlayback": false }]
    ],
    "splash": {
      "image": "./assets/caloverse-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#202625"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caloverse.app"
    },
    "android": {
      "package": "com.caloverse.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F8F3",
        "foregroundImage": "./assets/caloverse-mark.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/caloverse-icon.png",
      "name": "Calo Verse"
    }
  }
}
